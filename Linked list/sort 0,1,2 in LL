#approach
#1.If value is 0, add it to the "zero's" chain
#2.If value is 1, add it to the "one's" chain
#3.If value is 2, add it to the "two's" chain
#4.Finally, we connect zero's chain to one's chain and then one's chain to two's chain
#5.Handle edge cases where any chain might be empty
#time complexity=O(n)
#space complexity=O(1)
class Node:
    def __init__(self, val):
        self.data = val
        self.next = None

# LinkedList class to manage list operations
class LinkedList:
    def __init__(self):
        self.head = None

    # Function to insert a new node at the end
    def insert(self, val):
        new_node = Node(val)
        if not self.head:
            self.head = new_node  
            return
        temp = self.head
        while temp.next:
            temp = temp.next
        temp.next = new_node

    # Function to print the entire linked list
    def print_list(self):
        temp = self.head
        while temp:
            print(temp.data, end="")
            if temp.next:
                print(" -> ", end="")
            temp = temp.next
        print(" -> NULL")

# Solution class containing logic for sorting the list
class Solution:
    # Function to sort linked list of 0s, 1s, and 2s by rearranging the links
    def sortZeroOneTwo(self, ll):
        # Create dummy nodes for 0s, 1s, and 2s
        zero_dummy = Node(-1)
        one_dummy = Node(-1)
        two_dummy = Node(-1)

        # Create tail pointers to add new nodes in respective lists
        zero_tail = zero_dummy
        one_tail = one_dummy
        two_tail = two_dummy

        curr = ll.head

        # Traverse the original list
        while curr:
            if curr.data == 0:
                zero_tail.next = curr
                zero_tail = zero_tail.next
            elif curr.data == 1:
                one_tail.next = curr
                one_tail = one_tail.next
            else:
                two_tail.next = curr
                two_tail = two_tail.next
            curr = curr.next

        # Connect 0s list to 1s, and 1s to 2s
        zero_tail.next = one_dummy.next if one_dummy.next else two_dummy.next
        one_tail.next = two_dummy.next
        two_tail.next = None

        # Update original list head
        ll.head = zero_dummy.next


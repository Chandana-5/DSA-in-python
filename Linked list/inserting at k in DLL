class Node:
    def __init__(self, data):
        self.data = data
        self.prev = None
        self.next = None

class DoublyLinkedList:
    def __init__(self):
        self.head = None

    def insert_at_position(self, data, k):
        new_node = Node(data)

        # Case 1: Insert at head (k == 1)
        if k == 1:
            new_node.next = self.head
            if self.head:
                self.head.prev = new_node
            self.head = new_node
            return

        # Case 2: Traverse to (k-1)th node
        current = self.head
        count = 1
        while current and count < k - 1:
            current = current.next
            count += 1

        # Case 3: k is out of range
        if current is None:
            print("Position out of range")
            return

        # Case 4: Insert in middle or tail
        new_node.next = current.next      # link new node to next node
        new_node.prev = current           # link new node back to current
        if current.next:                  # if not inserting at tail
            current.next.prev = new_node  # link next node back to new node
        current.next = new_node           # link current to new node

    def display(self):
        current = self.head
        while current:
            print(current.data, end=" <-> " if current.next else "\n")
            current = current.next


# Usage
dll = DoublyLinkedList()
dll.insert_at_position(10, 1)   # [10]
dll.insert_at_position(20, 2)   # [10, 20]
dll.insert_at_position(30, 3)   # [10, 20, 30]
dll.insert_at_position(99, 2)   # insert 99 at position 2
dll.display()                   # 10 <-> 99 <-> 20 <-> 30

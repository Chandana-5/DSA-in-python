#brutte
#1.If the linked list is empty or has only one node, or k is 0, return the head as-is.
#2.Repeat the following steps k times:
#3.Initialize a pointer to traverse the list from head.
#4.Traverse to the second-last node of the list.
#5.Store the last node separately.
#6.Make the second-last node point to null (removing the last node).
#7.Insert the stored last node at the beginning by:
#8.Pointing its next to the current head.
#9.Updating the head to this node.
#time complexity-O(k*n)
#space complexity-O(1)
class ListNode:
    def __init__(self, val=0, next=None):
        self.val = val
        self.next = next

class Solution:
    # Function to rotate the list to the right by k positions
    def rotateRight(self, head: ListNode, k: int) -> ListNode:
        # If list is empty or has one node or no rotation needed
        if not head or not head.next or k == 0:
            return head

        # Repeat the rotation k times
        for _ in range(k):
            # Initialize two pointers
            curr = head
            prev = None

            # Traverse to the last node
            while curr.next:
                prev = curr
                curr = curr.next

            # Remove last node and move it to front
            prev.next = None
            curr.next = head
            head = curr
            return head

   

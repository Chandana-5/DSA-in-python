class Node:
    def __init__(self, data, prev=None, next=None):
        self.data = data
        self.prev = prev
        self.next = next

class Solution:
    def __init__(self):              
        self.head = None

    def deletehead(self):
        if self.head is None:       
            return None

        if self.head.next is None:  
            self.head = None
            return None

        temp = self.head             
        self.head = self.head.next  
        self.head.prev = None        
        temp.next = None            
        return self.head

#algorithm
#1.Create a new node.
#2.Store the data in the new node.
#3.Set newNode.prev = NULL.
#4.Set newNode.next = head.
#5.If head is not NULL, set head.prev = newNode.
#6.Move head to the new node.
    class Node:
    def __init__(self, data):
        self.data = data
        self.prev = None
        self.next = None

class DoublyLinkedList:
    def __init__(self):
        self.head = None

    def insert_at_head(self, data):
        new_node = Node(data)
        if self.head is None:
            self.head = new_node
            return
        new_node.next = self.head
        self.head.prev = new_node
        self.head = new_node

    def display(self):
        current = self.head
        while current:
            print(current.data, end=" <-> " if current.next else "\n")
            current = current.next


# Usage
dll = DoublyLinkedList()
dll.insert_at_head(10)
dll.insert_at_head(20)
dll.insert_at_head(30)
dll.display()  # 30 <-> 20 <-> 10

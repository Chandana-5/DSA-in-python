class Node:
    def __init__(self, data, prev=None, next=None):
        self.data = data
        self.prev = prev
        self.next = next

class Solution:
    def __init__(self):
        self.head = None

    def deletetail(self):
        if self.head is None:          
            return None

        if self.head.next is None: 
            self.head = None
            return None

        temp = self.head
        while temp.next is not None:   
            temp = temp.next

        # Now temp is the tail node
        temp.prev.next = None          
        temp.prev = None               

        return self.head              

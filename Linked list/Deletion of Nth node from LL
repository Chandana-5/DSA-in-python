#1.The first part involves the calculation of the length of the linked list.
#2.The second part involves the deletion of the (L-N+1)th node from the start of the linked list.
#3.If N equals 1, this means we have to delete the tail of the linked list.
#4.If N equals the length of the linked list, we have to delete the head of the linked list.
  class Solution:
    # Function to print the linked list
    def printLL(self, head):
        while head:
            print(head.data, end=" ")
            head = head.next

    # Function to delete the Nth node from the end
    def deleteNthNodeFromEnd(self, head, N):
        # If list is empty
        if head is None:
            return None

        cnt = 0
        temp = head

        # Count total number of nodes
        while temp:
            cnt += 1
            temp = temp.next

        # If N equals total nodes → delete head
        if cnt == N:
            return head.next

        # Calculate position from start
        res = cnt - N
        temp = head

        # Traverse to the node before target
        while temp:
            res -= 1
            if res == 0:
                break
            temp = temp.next

        # Delete the node
        temp.next = temp.next.next

        return head

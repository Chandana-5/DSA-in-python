class Node:
    def __init__(self, data, prev=None, next=None):  # ❌ 'head' → 'data'
        self.data = data
        self.next = next
        self.prev = prev

class Solution:
    def __init__(self):
        self.head = None

    def arrayToDoubleLinked(self, arr):
        if not arr:
            return None

        # Create head node from first element
        self.head = Node(arr[0])        
        temp = self.head
        prev = None

        for i in range(1, len(arr)):    
            new_node = Node(arr[i])    
            new_node.prev = temp      
            temp.next = new_node        
            temp = new_node            

        return self.head



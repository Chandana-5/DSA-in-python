def plusMinus(arr):
    # Write your code here
    cnt1=0
    cnt2=0
    cnt3=0
    for i in range(len(arr)):
        if arr[i]<0:
            cnt1+=1
        elif arr[i]==0:
            cnt2+=1
        else:
            cnt3+=1
    print(cnt3/len(arr))
    print(cnt1/len(arr))
    print(cnt2/len(arr))

if __name__ == '__main__':

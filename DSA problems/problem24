    max_count = 0
    count = 1
    max_type = arr[0]
    
    for i in range(1, len(arr)):
        if arr[i] == arr[i-1]:
            count += 1
        else:
            if count > max_count:
                max_count = count
                max_type = arr[i-1]
            count = 1  # reset for new number
    
    # check last element group
    if count > max_count:
        max_type = arr[-1]
    

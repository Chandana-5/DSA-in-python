def compareTriplets(a, b):
    # Write your code here
    alice_point=0
    bob_point=0
    for j in range(len(b)):
        if a[j]>b[j]:
            alice_point+=1
        elif b[j]>a[j]:
            bob_point+=1
    return [alice_point,bob_point]
